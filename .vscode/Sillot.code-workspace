    "Codegeex.Comment.LanguagePreference": "中文",
    "Codegeex.SidebarUI.LanguagePreference": "中文",
    "Codegeex.CandidateNum": "2 (中)",
    "Codegeex.CompletionModel": "CodeGeeX Pro[Beta]",
    "asciidoc.antora.enableAntoraSupport": false,
    "typescript.preferences.preferTypeOnlyAutoImports": true, // since vscode 1.85 // require TS 5.3+
    "files.autoSaveWhenNoErrors": true, // since vscode 1.86
    "files.autoSaveWorkspaceFilesOnly": true, // since vscode 1.86
    "explorer.fileNesting.expand": true, // since vscode 1.67
